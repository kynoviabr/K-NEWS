# K-NEWS — Environment (não commitar .env com segredos reais)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=your-secure-cron-secret
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
META_APP_ID=
META_APP_SECRET=
# Opcional: provedor preferido (deepseek|openai). Sem chave, o rascunho vem sem IA e precisa ser reescrito.
KNEWS_AI_PROVIDER=
# Desenvolvimento local: portal exibido em http://localhost:3000/portal (ou use guaruja.localhost:3000)
KNEWS_DEV_PORTAL_HOST=guaruja.localhost
# Somente local: aceita feeds em 127.0.0.1 (ignorado se o Supabase nao for local)
KNEWS_ALLOW_PRIVATE_FEEDS=
